# Copy to .env.local (gitignored) and fill in:
#   cp .env.example .env.local
#
# For the LOCAL Supabase stack, `supabase start` prints these values (API URL
# and anon key). For the hosted project, copy them from the Supabase dashboard
# under Project Settings -> API. Only EXPO_PUBLIC_-prefixed vars reach the app.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
