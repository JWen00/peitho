{
  "expo": {
    "name": "Peitho",
    "slug": "peitho",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "peitho",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Peitho uses speech recognition to transcribe your recordings after each session.",
        "NSMicrophoneUsageDescription": "Peitho records your voice so you can practice and review your impromptu speeches."
      },
      "bundleIdentifier": "com.anonymous.peitho"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Peitho records your voice so you can practice and review your impromptu speeches."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Peitho records your voice so you can practice and review your impromptu speeches.",
          "speechRecognitionPermission": "Peitho uses speech recognition to transcribe your recordings after each session."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
