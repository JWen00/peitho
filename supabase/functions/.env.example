# Copy to supabase/functions/.env for local development:
#   cp supabase/functions/.env.example supabase/functions/.env
#
# Inside the local stack SUPABASE_URL is http://kong:8000, the API gateway's
# in-network address. Storage signs playback URLs against it, so without this
# override a signed URL is unreachable from a simulator, a device or a browser.
# Supabase injects the right value in production; this is local-only. The name
# is not SUPABASE_PUBLIC_URL because the CLI skips any --env-file key starting
# with SUPABASE_.
#
# Use your machine's LAN IP instead of 127.0.0.1 when testing on a real phone.
PUBLIC_API_URL=http://127.0.0.1:54321
